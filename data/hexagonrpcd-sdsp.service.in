[Unit]
Description=Server for FastRPC remote procedure calls from Qualcomm SDSP
BindsTo=dev-fastrpc\x2dsdsp.device
After=dev-fastrpc\x2dsdsp.device msm-firmware-loader.service
Before=iio-sensor-proxy.service

[Service]
ExecStart=@bindir@/hexagonrpcd -f /dev/fastrpc-sdsp -d sdsp -s
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
